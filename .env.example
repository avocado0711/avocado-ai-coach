# LLM
DEEPSEEK_API_KEY=replace-with-a-real-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Authentication
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRE_HOURS=24
ADMIN_TOKEN=replace-with-a-separate-admin-token

# Paths. Relative application paths are resolved from this repository.
DATA_DIR=./data
CHROMA_PATH=./data/chroma_db
EMBED_MODEL_NAME=./models/fit-sport-emb
RERANK_MODEL_NAME=./models/bge-reranker-v2-m3
COLLECTION_NAME=sport_knowledge

# Retrieval. Calibrate thresholds on the held-out evaluation set.
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATES=50
RERANK_CANDIDATES=30
RERANK_CANDIDATES_CPU=6
RERANK_BATCH_SIZE=8
MIN_RELEVANCE_SCORE=0.25
MIN_VECTOR_SCORE=0.35
RETRIEVAL_CACHE_SIZE=256
PLAN_ADAPTATION_LOOKBACK_DAYS=56
SOURCE_REGISTRY_PATH=./docs/knowledge_registry.json
MODEL_MANIFEST_PATH=./docs/model_manifest.json

# Pilot controls
APP_ENV=development
POLICY_VERSION=2026-11-01
ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
PENDING_TTL_DAYS=7
FEEDBACK_RETENTION_DAYS=365
CLEAN_INTERVAL_HOURS=6
CHAT_LIMIT_PER_MINUTE=20
CHAT_LIMIT_PER_DAY=200
FEEDBACK_AUTO_INJECT=0
LEARNING_CACHE_TTL=300
